//@version=5
indicator("Trend Lines Extended - All", overlay=true, max_lines_count=500, max_bars_back=5000)

// Inputs
prd       = input.int(defval=20, title="Pivot Period", minval=5, maxval=50)
maxPivots = input.int(defval=15, title="Max Pivot Points to track", minval=3, maxval=30)
utcol     = input.color(defval=color.lime, title="Support Color", inline="tcol")
dtcol     = input.color(defval=color.red, title="Resistance Color", inline="tcol")
lineWidth = input.int(defval=1, title="Line Width", minval=1, maxval=4)
removeBroken = input.bool(defval=false, title="Remove Broken Lines")

// Pivot detection
ph = ta.pivothigh(prd, prd)
pl = ta.pivotlow(prd, prd)

// Arrays to store pivot history
var float[] phVals = array.new_float(0)
var int[]   phBars = array.new_int(0)
var float[] plVals = array.new_float(0)
var int[]   plBars = array.new_int(0)

// Arrays to track drawn lines for broken-line removal
var line[]  resistLines  = array.new_line(0)
var float[] resistSlopes = array.new_float(0)
var float[] resistOriginVal = array.new_float(0)
var int[]   resistOriginBar = array.new_int(0)

var line[]  supportLines  = array.new_line(0)
var float[] supportSlopes = array.new_float(0)
var float[] supportOriginVal = array.new_float(0)
var int[]   supportOriginBar = array.new_int(0)

// ─── New pivot HIGH → check for descending resistance lines ───
if not na(ph)
    int   newBar = bar_index - prd
    float newVal = ph

    if array.size(phVals) > 0
        for i = 0 to array.size(phVals) - 1
            float prevVal = array.get(phVals, i)
            int   prevBar = array.get(phBars, i)

            if newVal < prevVal  // descending → valid resistance
                float slope = (newVal - prevVal) / (newBar - prevBar)
                bool  valid = true

                // Validate: no close above the line between the two pivots
                for x = prevBar - prd + 1 to newBar
                    float lineVal = prevVal + slope * (x - prevBar)
                    int   offset  = bar_index - x
                    if offset >= 0 and offset < 5000 and close[offset] > lineVal
                        valid := false
                        break

                if valid
                    line ln = line.new(prevBar, prevVal, newBar, newVal,
                         color=dtcol, extend=extend.right, width=lineWidth)
                    // Track for broken-line removal
                    array.push(resistLines, ln)
                    array.push(resistSlopes, slope)
                    array.push(resistOriginVal, prevVal)
                    array.push(resistOriginBar, prevBar)

    // Store this pivot
    array.unshift(phVals, newVal)
    array.unshift(phBars, newBar)
    if array.size(phVals) > maxPivots
        array.pop(phVals)
        array.pop(phBars)

// ─── New pivot LOW → check for ascending support lines ───
if not na(pl)
    int   newBar = bar_index - prd
    float newVal = pl

    if array.size(plVals) > 0
        for i = 0 to array.size(plVals) - 1
            float prevVal = array.get(plVals, i)
            int   prevBar = array.get(plBars, i)

            if newVal > prevVal  // ascending → valid support
                float slope = (newVal - prevVal) / (newBar - prevBar)
                bool  valid = true

                // Validate: no close below the line between the two pivots
                for x = prevBar - prd + 1 to newBar
                    float lineVal = prevVal + slope * (x - prevBar)
                    int   offset  = bar_index - x
                    if offset >= 0 and offset < 5000 and close[offset] < lineVal
                        valid := false
                        break

                if valid
                    line ln = line.new(prevBar, prevVal, newBar, newVal,
                         color=utcol, extend=extend.right, width=lineWidth)
                    // Track for broken-line removal
                    array.push(supportLines, ln)
                    array.push(supportSlopes, slope)
                    array.push(supportOriginVal, prevVal)
                    array.push(supportOriginBar, prevBar)

    // Store this pivot
    array.unshift(plVals, newVal)
    array.unshift(plBars, newBar)
    if array.size(plVals) > maxPivots
        array.pop(plVals)
        array.pop(plBars)

// ─── Optional: remove lines that price has broken through ───
if removeBroken
    // Check resistance lines: broken if close goes above
    if array.size(resistLines) > 0
        for i = array.size(resistLines) - 1 to 0
            float lSlope  = array.get(resistSlopes, i)
            float lOriVal = array.get(resistOriginVal, i)
            int   lOriBar = array.get(resistOriginBar, i)
            float currentLineVal = lOriVal + lSlope * (bar_index - lOriBar)
            if close > currentLineVal
                line.delete(array.get(resistLines, i))
                array.remove(resistLines, i)
                array.remove(resistSlopes, i)
                array.remove(resistOriginVal, i)
                array.remove(resistOriginBar, i)

    // Check support lines: broken if close goes below
    if array.size(supportLines) > 0
        for i = array.size(supportLines) - 1 to 0
            float lSlope  = array.get(supportSlopes, i)
            float lOriVal = array.get(supportOriginVal, i)
            int   lOriBar = array.get(supportOriginBar, i)
            float currentLineVal = lOriVal + lSlope * (bar_index - lOriBar)
            if close < currentLineVal
                line.delete(array.get(supportLines, i))
                array.remove(supportLines, i)
                array.remove(supportSlopes, i)
                array.remove(supportOriginVal, i)
                array.remove(supportOriginBar, i)
